{
  "name": "dreamteam-manager",
  "version": "0.2.0",
  "private": true,
  "description": "DreamTeam desktop manager with Auto Play, Scout and Trading Hall",
  "main": "src/main/main.cjs",
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/ensure-runtime.cjs && concurrently -k \"vite --host 127.0.0.1 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "dist": "node scripts/ensure-runtime.cjs && node scripts/quiz-bundle.cjs && npm run build && electron-builder --win nsis",
    "dist:portable": "node scripts/ensure-runtime.cjs && node scripts/quiz-bundle.cjs && npm run build && electron-builder --win portable",
    "postinstall": "node scripts/ensure-runtime.cjs",
    "repair-runtime": "node scripts/ensure-runtime.cjs",
    "mcp:sync": "node src/main/services/mcp-sync.cjs",
    "quiz:bundle": "node scripts/quiz-bundle.cjs"
  },
  "dependencies": {
    "playwright": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.83",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.dreamteam.automator",
    "productName": "DreamTeam Manager",
    "artifactName": "DreamTeamManager-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "default-tasks",
        "to": "default-tasks"
      }
    ],
    "asarUnpack": [
      "node_modules/playwright-core/.local-browsers/**/*",
      "node_modules/playwright/.local-browsers/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "DreamTeam Manager"
    }
  }
}
